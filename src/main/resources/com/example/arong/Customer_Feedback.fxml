<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="600" prefWidth="800" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.arong.CustomerFeedbackController">

    <Label fx:id="loginMessageLabel" layoutX="150" layoutY="170" textFill="red" />


    <!-- ============ CUSTOMER DASHBOARD (EVENT 2) ============ -->
    <Label layoutX="50" layoutY="220" style="-fx-font-size: 18px; -fx-font-weight: bold;" text="Customer Dashboard" />

    <Button fx:id="rateProductMenuButton" layoutX="50" layoutY="255" onAction="#handleOpenRateProduct" prefWidth="150" text="Rate Product" />


    <!-- ============ RATE PRODUCT AREA (EVENT 3–6) ============ -->
    <Label layoutX="50" layoutY="300" style="-fx-font-size: 18px; -fx-font-weight: bold;" text="Product Feedback" />

    <!-- Optional: choose which product -->
    <Label layoutX="50" layoutY="340" text="Product Name:" />
    <TextField fx:id="productNameField" layoutX="160" layoutY="335" prefWidth="250" promptText="Enter product name" />

    <!-- event-3: rating 1–5 and optional review text -->
    <Label layoutX="50" layoutY="375" text="Rating (1–5):" />
    <ComboBox fx:id="ratingComboBox" layoutX="160" layoutY="370" prefWidth="80" />

    <Label layoutX="50" layoutY="410" text="Review:" />
    <TextArea fx:id="reviewTextArea" layoutX="160" layoutY="405" prefHeight="100" prefWidth="350" promptText="Write your review (optional, but encouraged)" />

    <!-- event-4: validation errors (rating range, non-empty if required) -->
    <Label fx:id="validationMessageLabel" layoutX="50" layoutY="520" textFill="red" />

    <!-- event-5: store feedback, event-6: thank you message -->
    <Button fx:id="submitFeedbackButton" layoutX="50" layoutY="550" onAction="#handleSubmitFeedback" prefWidth="150" text="Submit Feedback" />

    <Label fx:id="statusLabel" layoutX="220" layoutY="555" textFill="green" />

</AnchorPane>
