<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.chart.BarChart?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="650.0" prefWidth="950.0" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.oop_final_project.CashFlowController">

    <children>

        <!-- ============ CASH FLOW REPORT HEADER ============ -->
        <Label layoutX="50.0" layoutY="30.0" style="-fx-font-size: 22px; -fx-font-weight: bold;" text="Cash Flow Report" />


        <!-- ============ DATE SELECTION AREA (EVENT 3) ============ -->
        <Label layoutX="50.0" layoutY="80.0" text="Select Month (YYYY-MM):" />
        <TextField fx:id="monthField" layoutX="220.0" layoutY="75.0" prefWidth="120.0" promptText="2025-01" />

        <Label layoutX="50.0" layoutY="115.0" text="Or Select Date Range:" />

        <Label layoutX="50.0" layoutY="145.0" text="From:" />
        <DatePicker fx:id="fromDatePicker" layoutX="100.0" layoutY="140.0" prefWidth="160.0" />

        <Label layoutX="280.0" layoutY="145.0" text="To:" />
        <DatePicker fx:id="toDatePicker" layoutX="320.0" layoutY="140.0" prefWidth="160.0" />

        <!-- event-4: validation -->
        <Label fx:id="validationMessageLabel" layoutX="50.0" layoutY="175.0" textFill="red" />

        <!-- event-5: fetch inflow/outflow data -->
        <Button fx:id="generateCashFlowButton" layoutX="50.0" layoutY="205.0" onAction="#handleGenerateCashFlow" prefWidth="180.0" text="Generate Cash Flow" />


        <!-- ============ CASH FLOW CHART (EVENT 6) ============ -->
        <Label layoutX="500.0" layoutY="30.0" style="-fx-font-size: 16px; -fx-font-weight: bold;" text="Cash Flow Chart" />

        <BarChart fx:id="cashFlowChart" layoutX="500.0" layoutY="55.0" prefHeight="250.0" prefWidth="400.0">
            <xAxis>
                <CategoryAxis label="Category" fx:id="xAxis" />
            </xAxis>
            <yAxis>
                <NumberAxis fx:id="yAxis" label="Amount" />
            </yAxis>
        </BarChart>


        <!-- ============ TABLE SUMMARY (EVENT 6) ============ -->
        <Label layoutX="50.0" layoutY="260.0" style="-fx-font-size: 16px; -fx-font-weight: bold;" text="Cash Flow Summary" />

        <TableView fx:id="cashFlowTable" layoutX="50.0" layoutY="290.0" prefHeight="280.0" prefWidth="850.0">

            <columns>
                <TableColumn fx:id="typeColumn" prefWidth="200.0" text="Type (Inflow / Outflow)" />

                <TableColumn fx:id="amountColumn" prefWidth="150.0" text="Amount" />

                <TableColumn fx:id="dateColumn" prefWidth="150.0" text="Date" />

                <TableColumn fx:id="noteColumn" prefWidth="350.0" text="Description / Note" />
            </columns>
        </TableView>

        <!-- STATUS MESSAGE -->
        <Label fx:id="statusLabel" layoutX="50.0" layoutY="585.0" textFill="green" />

    </children>

</AnchorPane>
