<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="600" prefWidth="800" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.arong.TaxReportController">

    <Label fx:id="loginMessageLabel" layoutX="150" layoutY="170" textFill="red" />


    <!-- ================= DASHBOARD (EVENT 2) ================= -->
    <Label layoutX="50" layoutY="220" style="-fx-font-size: 18px; -fx-font-weight: bold;" text="Dashboard" />

    <Button fx:id="generateTaxReportMenuButton" layoutX="50" layoutY="260" onAction="#handleOpenTaxReport" prefWidth="200" text="Generate Tax Report" />


    <!-- ======== TAX REPORT AREA (EVENT 3–7) ======== -->
    <Label layoutX="50" layoutY="320" style="-fx-font-size: 18px; -fx-font-weight: bold;" text="Tax Report" />

    <!-- event-3: enter fiscal year -->
    <Label layoutX="50" layoutY="360" text="Fiscal Year:" />
    <TextField fx:id="fiscalYearField" layoutX="150" layoutY="355" prefWidth="150" promptText="e.g. 2025" />

    <!-- event-4: validation message (year format) -->
    <Label fx:id="validationMessageLabel" layoutX="50" layoutY="390" textFill="red" />

    <!-- event-5: calculate taxable amount, event-6: show summary -->
    <Button fx:id="generateTaxReportButton" layoutX="50" layoutY="420" onAction="#handleGenerateTaxReport" prefWidth="150" text="Generate Report" />

    <!-- Simple numeric summary -->
    <Label layoutX="417.0" layoutY="360.0" text="Taxable Amount:" />
    <Label fx:id="taxableAmountLabel" layoutX="523.0" layoutY="360.0" text="0.0" />

    <Label layoutX="424.0" layoutY="390.0" text="Estimated Tax:" />
    <Label fx:id="taxAmountLabel" layoutX="523.0" layoutY="390.0" text="0.0" />

    <!-- Detailed summary text (event-6) -->
    <TextArea fx:id="taxSummaryTextArea" editable="false" layoutX="250" layoutY="420" prefHeight="120" prefWidth="500" promptText="Tax summary report will appear here..." />

    <!-- event-7: export as PDF -->
    <Button fx:id="exportPdfButton" layoutX="50" layoutY="470" onAction="#handleExportPdf" prefWidth="150" text="Export as PDF" />

    <!-- status for export or general messages -->
    <Label fx:id="statusLabel" layoutX="50" layoutY="510" textFill="green" />

</AnchorPane>
