<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.chart.BarChart?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="650.0" prefWidth="950.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.oop_final_project.SalesSummaryController">

    <children>

        <Label fx:id="loginMessageLabel" layoutX="150.0" layoutY="170.0" textFill="red" />


        <!-- ============ SALES DASHBOARD (EVENT 2 & 3) ============ -->
        <Label layoutX="50.0" layoutY="220.0" style="-fx-font-size: 18px; -fx-font-weight: bold;" text="Sales Dashboard" />

        <!-- event-3: Click “View Sales Summary.” -->
        <Button fx:id="viewSalesSummaryButton" layoutX="50.0" layoutY="255.0" onAction="#handleOpenSalesSummary" prefWidth="200.0" text="View Sales Summary" />


        <!-- ============ SALES SUMMARY AREA (EVENT 4–8) ============ -->
        <Label layoutX="50.0" layoutY="300.0" style="-fx-font-size: 16px; -fx-font-weight: bold;" text="Sales Summary" />

        <!-- event-4: select date or month -->
        <Label layoutX="50.0" layoutY="335.0" text="Select Date:" />
        <DatePicker fx:id="datePicker" layoutX="140.0" layoutY="330.0" prefWidth="160.0" />

        <Label layoutX="50.0" layoutY="370.0" text="Or Month (YYYY-MM):" />
        <TextField fx:id="monthField" layoutX="190.0" layoutY="365.0" prefWidth="110.0" promptText="2025-01" />

        <!-- validation / info (for date/month input) -->
        <Label fx:id="validationMessageLabel" layoutX="50.0" layoutY="395.0" textFill="red" />

        <!-- event-5 & 6: Fetch sales data, calculate revenue & display -->
        <Button fx:id="generateSummaryButton" layoutX="50.0" layoutY="420.0" onAction="#handleGenerateSummary" prefWidth="180.0" text="Generate Summary" />


        <!-- ============ BAR CHART (EVENT 6) ============ -->
        <Label layoutX="350.0" layoutY="300.0" style="-fx-font-size: 14px; -fx-font-weight: bold;" text="Revenue by Day / Month" />

        <BarChart fx:id="salesBarChart" layoutX="350.0" layoutY="320.0" prefHeight="220.0" prefWidth="550.0">
            <xAxis>
                <CategoryAxis label="Period" fx:id="xAxis" />
            </xAxis>
            <yAxis>
                <NumberAxis fx:id="yAxis" label="Revenue" />
            </yAxis>
        </BarChart>


        <!-- ============ TABLE VIEW (EVENT 6) ============ -->
        <Label layoutX="50.0" layoutY="460.0" style="-fx-font-size: 14px; -fx-font-weight: bold;" text="Sales Summary Table" />

        <TableView fx:id="salesSummaryTable" layoutX="50.0" layoutY="485.0" prefHeight="120.0" prefWidth="850.0">
            <columns>
                <TableColumn fx:id="periodColumn" prefWidth="200.0" text="Date / Month" />
                <TableColumn fx:id="ordersColumn" prefWidth="150.0" text="Orders" />
                <TableColumn fx:id="revenueColumn" prefWidth="200.0" text="Total Revenue" />
                <TableColumn fx:id="discountColumn" prefWidth="150.0" text="Total Discount" />
                <TableColumn fx:id="netRevenueColumn" prefWidth="150.0" text="Net Revenue" />
            </columns>
        </TableView>


        <!-- ============ EXPORT SUMMARY (EVENT 7–8) ============ -->
        <!-- event-7: Click “Export Summary.” -->
        <Button fx:id="exportSummaryButton" layoutX="50.0" layoutY="615.0" onAction="#handleExportSummary" prefWidth="160.0" text="Export Summary" />

        <!-- event-8: Display success message -->
        <Label fx:id="statusLabel" layoutX="230.0" layoutY="620.0" textFill="green" />

    </children>
</AnchorPane>
