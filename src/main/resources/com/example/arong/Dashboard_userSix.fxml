<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.example.arong.DashboardController">
            prefWidth="900.0" prefHeight="650.0">

    <children>

        <!-- TITLE AREA -->
        <Label text="Customer Dashboard"
               layoutX="50.0" layoutY="30.0"
               style="-fx-font-size: 24px; -fx-font-weight: bold;" />

        <Label fx:id="welcomeLabel"
               text="Welcome, Dear Customer"
               layoutX="50.0" layoutY="70.0"
               style="-fx-font-size: 14px;" />


        <!-- MAIN MENU BUTTONS (ALL 8 GOALS) -->

        <!-- GOAL 1: Register / Edit Account -->
        <Button fx:id="registerAccountButton"
                text="Register New Account"
                layoutX="50.0" layoutY="120.0"
                prefWidth="250.0"
                onAction="#handleRegisterAccount" />

        <!-- GOAL 5: Update Profile -->
        <Button fx:id="editProfileButton"
                text="Edit Profile"
                layoutX="50.0" layoutY="160.0"
                prefWidth="250.0"
                onAction="#handleEditProfile" />

        <!-- GOAL 2: Place Order -->
        <Button fx:id="browseProductsButton"
                text="Browse Products / Place Order"
                layoutX="50.0" layoutY="200.0"
                prefWidth="250.0"
                onAction="#handleBrowseProducts" />

        <!-- GOAL 3: Track Order -->
        <Button fx:id="trackOrderButton"
                text="Track Order"
                layoutX="50.0" layoutY="240.0"
                prefWidth="250.0"
                onAction="#handleTrackOrder" />

        <!-- GOAL 4: Feedback -->
        <Button fx:id="giveFeedbackButton"
                text="Rate Product / Feedback"
                layoutX="50.0" layoutY="280.0"
                prefWidth="250.0"
                onAction="#handleFeedback" />

        <!-- GOAL 6: Purchase History -->
        <Button fx:id="purchaseHistoryButton"
                text="View Purchase History"
                layoutX="50.0" layoutY="320.0"
                prefWidth="250.0"
                onAction="#handlePurchaseHistory" />

        <!-- GOAL 7: Exchange Request -->
        <Button fx:id="exchangeRequestButton"
                text="Request Product Exchange"
                layoutX="50.0" layoutY="360.0"
                prefWidth="250.0"
                onAction="#handleExchangeRequest" />

        <!-- GOAL 8: Wishlist -->
        <Button fx:id="wishlistButton"
                text="Wishlist"
                layoutX="50.0" layoutY="400.0"
                prefWidth="250.0"
                onAction="#handleWishlist" />


        <!-- LOGOUT BUTTON -->
        <Button fx:id="logoutButton"
                text="Logout"
                layoutX="50.0" layoutY="460.0"
                prefWidth="250.0"
                onAction="#handleLogout" />

        <!-- STATUS LABEL -->
        <Label fx:id="statusLabel"
               layoutX="50.0" layoutY="520.0"
               textFill="green" />

    </children>
</AnchorPane>
