<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="600" prefWidth="900" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.arong.PendingPaymentsController">

    <Label fx:id="loginMessageLabel" layoutX="150" layoutY="170" textFill="red" />


    <!-- ================= DASHBOARD (EVENT 2) ================= -->
    <Label layoutX="50" layoutY="220" style="-fx-font-size: 18px; -fx-font-weight: bold;" text="Dashboard" />

    <Button fx:id="pendingPaymentsButton" layoutX="50" layoutY="260" onAction="#handleOpenPendingPayments" prefWidth="180" text="Pending Payments" />


    <!-- ======== PENDING PAYMENTS AREA (EVENT 3–7) ======== -->
    <Label layoutX="50" layoutY="320" style="-fx-font-size: 18px; -fx-font-weight: bold;" text="Verify Pending Payments" />

    <!-- event-3: system retrieves unpaid invoices (done in controller,
         results shown in this TableView) -->
    <TableView fx:id="pendingInvoicesTable" layoutX="50" layoutY="350" prefHeight="200" prefWidth="500">
        <columns>
            <TableColumn fx:id="invoiceIdColumn" prefWidth="90" text="Invoice ID" />
            <TableColumn fx:id="supplierColumn" prefWidth="140" text="Supplier" />
            <TableColumn fx:id="amountColumn" prefWidth="100" text="Amount" />
            <TableColumn fx:id="dueDateColumn" prefWidth="100" text="Due Date" />
            <TableColumn fx:id="statusColumn" prefWidth="70" text="Status" />
        </columns>
    </TableView>

    <!-- event-4: Accountant selects invoice & verifies supplier details -->
    <Label layoutX="580" layoutY="350" style="-fx-font-size: 14px; -fx-font-weight: bold;" text="Selected Invoice Details" />

    <Label layoutX="580" layoutY="380" text="Invoice ID:" />
    <TextField fx:id="invoiceIdField" editable="false" layoutX="680" layoutY="375" prefWidth="180" />

    <Label layoutX="580" layoutY="410" text="Supplier:" />
    <TextField fx:id="supplierField" editable="false" layoutX="680" layoutY="405" prefWidth="180" />

    <Label layoutX="580" layoutY="440" text="Amount:" />
    <TextField fx:id="amountField" editable="false" layoutX="680" layoutY="435" prefWidth="180" />

    <Label layoutX="580" layoutY="470" text="Due Date:" />
    <TextField fx:id="dueDateField" editable="false" layoutX="680" layoutY="465" prefWidth="180" />

    <!-- event-5: mark payment as cleared -->
    <Button fx:id="markClearedButton" layoutX="580" layoutY="500" onAction="#handleMarkAsCleared" prefWidth="150" text="Mark as Cleared" />

    <!-- event-7: success message after DB update (event-6) -->
    <Label fx:id="statusLabel" layoutX="580" layoutY="540" textFill="green" />

</AnchorPane>
