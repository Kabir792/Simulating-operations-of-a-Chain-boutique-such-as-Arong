<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="600" prefWidth="800" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.arong.CustomerExchangeController">

    <Label fx:id="loginMessageLabel" layoutX="150" layoutY="170" textFill="red" />


    <!-- ============ CUSTOMER DASHBOARD (EVENT 2) ============ -->
    <Label layoutX="50" layoutY="220" style="-fx-font-size: 18px; -fx-font-weight: bold;" text="Customer Dashboard" />

    <Button fx:id="exchangeRequestMenuButton" layoutX="50" layoutY="255" onAction="#handleOpenExchangeRequest" prefWidth="180" text="Exchange Request" />


    <!-- ============ EXCHANGE REQUEST AREA (EVENT 3–6) ============ -->
    <Label layoutX="50" layoutY="300" style="-fx-font-size: 18px; -fx-font-weight: bold;" text="Product Exchange Request" />

    <!-- event-3: Enter order ID -->
    <Label layoutX="50" layoutY="340" text="Order ID:" />
    <TextField fx:id="orderIdField" layoutX="150" layoutY="335" prefWidth="200" promptText="Enter your order ID" />

    <!-- event-3: Reason for exchange -->
    <Label layoutX="50" layoutY="380" text="Reason:" />
    <TextArea fx:id="reasonArea" layoutX="150" layoutY="375" prefHeight="100" prefWidth="350" promptText="Explain why you want to exchange the product" />

    <!-- event-4: Validation / eligibility message -->
    <Label fx:id="validationMessageLabel" layoutX="50" layoutY="490" textFill="red" />

    <!-- event-5: Submit exchange (DP) -->
    <Button fx:id="submitExchangeButton" layoutX="50" layoutY="520" onAction="#handleSubmitExchange" prefWidth="200" text="Submit Exchange Request" />

    <!-- event-6: Confirmation message -->
    <Label fx:id="statusLabel" layoutX="270" layoutY="525" textFill="green" />

</AnchorPane>
