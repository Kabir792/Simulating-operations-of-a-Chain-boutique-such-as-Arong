<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="600" prefWidth="800" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.arong.DailySalesController">

    <Label fx:id="loginMessageLabel" layoutX="150" layoutY="170" textFill="red" />


    <!-- ======== RECORD DAILY SALES AREA (EVENT 3–6) ======== -->
    <Label layoutX="50" layoutY="320" style="-fx-font-size: 18px; -fx-font-weight: bold;" text="Record Daily Sales" />

    <!-- event-3 inputs -->
    <Label layoutX="50" layoutY="360" text="Date:" />
    <DatePicker fx:id="datePicker" layoutX="180" layoutY="355" prefWidth="150" />

    <Label layoutX="50" layoutY="395" text="Cash Sales:" />
    <TextField fx:id="cashSalesField" layoutX="180" layoutY="390" prefWidth="150" promptText="e.g. 5000" />

    <Label layoutX="50" layoutY="430" text="Card Sales:" />
    <TextField fx:id="cardSalesField" layoutX="180" layoutY="425" prefWidth="150" promptText="e.g. 3000" />

    <Label layoutX="50" layoutY="465" text="Online Payments:" />
    <TextField fx:id="onlineSalesField" layoutX="180" layoutY="460" prefWidth="150" promptText="e.g. 2000" />

    <Label layoutX="50" layoutY="500" text="Total Daily Revenue:" />
    <TextField fx:id="totalSalesField" editable="false" layoutX="180" layoutY="495" prefWidth="150" promptText="Auto-calculated" />

    <!-- event-5: calculate + update table, event-4: validation in controller -->
    <Button fx:id="saveSalesButton" layoutX="50.0" layoutY="557.0" onAction="#handleSaveSales" prefWidth="150" text="Save Sales Record" />

    <!-- event-6: success message -->
    <Label fx:id="statusLabel" layoutX="220" layoutY="540" textFill="green" />


    <!-- ======== SALES TABLE (EVENT 5 – data presentation) ======== -->
    <TableView fx:id="salesTable" layoutX="287.0" layoutY="32.0" prefHeight="210" prefWidth="380">

        <columns>
            <TableColumn fx:id="dateColumn" prefWidth="80" text="Date" />
            <TableColumn fx:id="cashColumn" prefWidth="75" text="Cash" />
            <TableColumn fx:id="cardColumn" prefWidth="75" text="Card" />
            <TableColumn fx:id="onlineColumn" prefWidth="75" text="Online" />
            <TableColumn fx:id="totalColumn" prefWidth="75" text="Total" />
        </columns>
    </TableView>
   <Label fx:id="c" layoutX="45.0" layoutY="531.0" text="Cost of Goods Sold" />
   <TextField fx:id="costOfGoodsSoldTextField" layoutX="180.0" layoutY="527.0" />

</AnchorPane>
