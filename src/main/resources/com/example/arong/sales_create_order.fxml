<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="650.0" prefWidth="950.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.oop_final_project.SalesCreateOrderController">

    <children>

        <Label fx:id="loginMessageLabel" layoutX="150.0" layoutY="170.0" textFill="red" />


        <!-- ============ SALES DASHBOARD (EVENT 2 & 3) ============ -->
        <Label layoutX="50.0" layoutY="220.0" style="-fx-font-size: 18px; -fx-font-weight: bold;" text="Sales Dashboard" />

        <!-- event-3: Click “Create New Order.” -->
        <Button fx:id="createOrderButton" layoutX="50.0" layoutY="255.0" onAction="#handleOpenCreateOrder" prefWidth="200.0" text="Create New Order" />


        <!-- ============ CREATE ORDER AREA (EVENT 4–9) ============ -->
        <Label layoutX="50.0" layoutY="300.0" style="-fx-font-size: 16px; -fx-font-weight: bold;" text="Create New Sales Order" />

        <!-- event-4: Enter Customer ID -->
        <Label layoutX="50.0" layoutY="335.0" text="Customer ID:" />
        <TextField fx:id="customerIdField" layoutX="150.0" layoutY="330.0" prefWidth="180.0" promptText="Enter Customer ID" />

        <!-- ========== PRODUCTS LIST (SELECT PRODUCTS) ========== -->
        <Label layoutX="50.0" layoutY="365.0" style="-fx-font-size: 14px; -fx-font-weight: bold;" text="Available Products" />

        <TableView fx:id="productsTable" layoutX="50.0" layoutY="390.0" prefHeight="180.0" prefWidth="380.0">
            <columns>
                <TableColumn fx:id="productNameColumn" prefWidth="180.0" text="Product" />
                <TableColumn fx:id="productPriceColumn" prefWidth="100.0" text="Price" />
                <TableColumn fx:id="productStockColumn" prefWidth="80.0" text="Stock" />
            </columns>
        </TableView>

        <Label layoutX="50.0" layoutY="580.0" text="Quantity:" />
        <TextField fx:id="quantityField" layoutX="120.0" layoutY="575.0" prefWidth="60.0" promptText="1" />

        <!-- event-4 (select product) & event-5 (availability checked in controller) -->
        <Button fx:id="addToOrderButton" layoutX="200.0" layoutY="575.0" onAction="#handleAddProductToOrder" prefWidth="120.0" text="Add to Order" />


        <!-- ========== ORDER ITEMS / SUMMARY (EVENT 6–9) ========== -->

        <Label layoutX="470.0" layoutY="300.0" style="-fx-font-size: 14px; -fx-font-weight: bold;" text="Order Items" />

        <TableView fx:id="orderItemsTable" layoutX="470.0" layoutY="325.0" prefHeight="180.0" prefWidth="430.0">
            <columns>
                <TableColumn fx:id="orderProductColumn" prefWidth="180.0" text="Product" />
                <TableColumn fx:id="orderQtyColumn" prefWidth="60.0" text="Qty" />
                <TableColumn fx:id="orderLineTotalColumn" prefWidth="120.0" text="Line Total" />
            </columns>
        </TableView>

        <!-- event-6: Calculate subtotal, discount, total -->
        <Button fx:id="calculateButton" layoutX="470.0" layoutY="515.0" onAction="#handleCalculateTotals" prefWidth="140.0" text="Calculate Totals" />

        <Label layoutX="630.0" layoutY="520.0" text="Subtotal:" />
        <Label fx:id="subtotalLabel" layoutX="700.0" layoutY="520.0" text="0.00" />

        <Label layoutX="630.0" layoutY="545.0" text="Discount:" />
        <Label fx:id="discountLabel" layoutX="700.0" layoutY="545.0" text="0.00" />

        <Label layoutX="630.0" layoutY="570.0" text="Total:" />
        <Label fx:id="totalLabel" layoutX="700.0" layoutY="570.0" text="0.00" />

        <!-- event-7: order summary display -->
        <Label layoutX="470.0" layoutY="550.0" text="Order Summary" />
        <TextArea fx:id="orderSummaryArea" editable="false" layoutX="470.0" layoutY="575.0" prefHeight="60.0" prefWidth="430.0" promptText="Order summary will appear here..." />

        <!-- general validation / messages -->
        <Label fx:id="validationMessageLabel" layoutX="50.0" layoutY="610.0" textFill="red" />

        <!-- event-7 & event-8: Confirm Order button -->
        <Button fx:id="confirmOrderButton" layoutX="50.0" layoutY="610.0" onAction="#handleConfirmOrder" prefWidth="140.0" text="Confirm Order" />

        <!-- event-9: “Order Created Successfully.” -->
        <Label fx:id="statusLabel" layoutX="210.0" layoutY="615.0" textFill="green" />

    </children>
</AnchorPane>
