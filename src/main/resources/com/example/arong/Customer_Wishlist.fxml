<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="600" prefWidth="850" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.arong.CustomerWishlistController">

    <Label fx:id="loginMessageLabel" layoutX="130" layoutY="170" textFill="red" />


    <!-- ============ CUSTOMER DASHBOARD (EVENT 2) ============ -->
    <Label layoutX="40" layoutY="220" style="-fx-font-size: 18px; -fx-font-weight: bold;" text="Customer Dashboard" />

    <Label layoutX="40" layoutY="255" text="Browse Products:" />

    <!-- event-2: Browse products -->
    <TableView fx:id="productsTable" layoutX="40" layoutY="280" prefHeight="200" prefWidth="350">
        <columns>
            <TableColumn fx:id="productNameColumn" prefWidth="150" text="Product" />
            <TableColumn fx:id="priceColumn" prefWidth="80" text="Price" />
            <TableColumn fx:id="availabilityColumn" prefWidth="100" text="Available" />
        </columns>
    </TableView>

    <!-- event-2 button: Add to Wishlist -->
    <Button fx:id="addToWishlistButton" layoutX="40" layoutY="500" onAction="#handleAddToWishlist" prefWidth="150" text="Add to Wishlist" />


    <!-- event-3 & event-4 messages -->
    <Label fx:id="errorMessageLabel" layoutX="210" layoutY="505" textFill="red" />


    <!-- ============ WISHLIST AREA (EVENT 4–5) ============ -->
    <Label layoutX="430" layoutY="255" style="-fx-font-size: 18px; -fx-font-weight: bold;" text="Your Wishlist" />

    <TableView fx:id="wishlistTable" layoutX="430" layoutY="280" prefHeight="200" prefWidth="350">
        <columns>
            <TableColumn fx:id="wishlistProductColumn" prefWidth="200" text="Product" />
            <TableColumn fx:id="wishlistPriceColumn" prefWidth="130" text="Price" />
        </columns>
    </TableView>

    <!-- event-5 success message -->
    <Label fx:id="statusLabel" layoutX="430" layoutY="500" textFill="green" />

</AnchorPane>
