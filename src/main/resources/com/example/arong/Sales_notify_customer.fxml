<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="650.0" prefWidth="950.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.oop_final_project.SalesNotifyController">

    <children>

        <Label fx:id="loginMessageLabel" layoutX="150.0" layoutY="170.0" textFill="red" />


        <!-- ============ SALES DASHBOARD (EVENT 2) ============ -->
        <Label layoutX="50.0" layoutY="220.0" style="-fx-font-size: 18px; -fx-font-weight: bold;" text="Sales Dashboard" />

        <Label layoutX="50.0" layoutY="255.0" style="-fx-font-size: 14px; -fx-font-weight: bold;" text="Orders" />

        <!-- ============ ORDERS TABLE (EVENT 3–5) ============ -->
        <TableView fx:id="ordersTable" layoutX="50.0" layoutY="280.0" prefHeight="230.0" prefWidth="480.0">
            <columns>
                <TableColumn fx:id="orderIdColumn" prefWidth="100.0" text="Order ID" />
                <TableColumn fx:id="customerNameColumn" prefWidth="150.0" text="Customer" />
                <TableColumn fx:id="statusColumn" prefWidth="120.0" text="Status" />
                <TableColumn fx:id="orderDateColumn" prefWidth="110.0" text="Order Date" />
            </columns>
        </TableView>

        <!-- event-3: select order & click “Send Update” -->
        <Button fx:id="sendUpdateButton" layoutX="50.0" layoutY="520.0" onAction="#handleSendUpdate" prefWidth="150.0" text="Send Update" />

        <Label fx:id="ordersMessageLabel" layoutX="220.0" layoutY="525.0" textFill="red" />


        <!-- ============ CUSTOMER CONTACT & NOTIFICATION (EVENT 4–6) ============ -->
        <Label layoutX="570.0" layoutY="255.0" style="-fx-font-size: 14px; -fx-font-weight: bold;" text="Customer Contact Info" />

        <!-- event-4: system retrieves contact info and shows here -->
        <Label layoutX="570.0" layoutY="285.0" text="Email:" />
        <Label fx:id="customerEmailLabel" layoutX="640.0" layoutY="285.0" text="" />

        <Label layoutX="570.0" layoutY="310.0" text="Phone:" />
        <Label fx:id="customerPhoneLabel" layoutX="640.0" layoutY="310.0" text="" />

        <Label layoutX="570.0" layoutY="335.0" text="Current Status:" />
        <Label fx:id="currentStatusLabel" layoutX="680.0" layoutY="335.0" text="" />

        <!-- event-5: system sends SMS/email (logic in controller) -->
        <!-- We just show a status label in UI -->

        <!-- event-6: show “Notification Sent Successfully.” -->
        <Label fx:id="statusLabel" layoutX="570.0" layoutY="370.0" textFill="green" />

    </children>
</AnchorPane>
