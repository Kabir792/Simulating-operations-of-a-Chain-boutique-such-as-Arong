<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="650" prefWidth="900" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.arong.CustomerOrderController">

    <Label fx:id="loginMessageLabel" layoutX="150" layoutY="170" textFill="red" />


    <!-- ============ CUSTOMER DASHBOARD (EVENT 2) ============ -->
    <Label layoutX="50" layoutY="210" style="-fx-font-size: 18px; -fx-font-weight: bold;" text="Customer Dashboard" />


    <!-- ============ PRODUCTS (EVENT 3 & 6) ============ -->
    <Label layoutX="50" layoutY="245" text="Available Products:" />

    <TableView fx:id="productsTable" layoutX="50" layoutY="270" prefHeight="180" prefWidth="360">
        <columns>
            <TableColumn fx:id="productNameColumn" prefWidth="150" text="Product" />
            <TableColumn fx:id="priceColumn" prefWidth="100" text="Price" />
            <TableColumn fx:id="stockColumn" prefWidth="90" text="Stock" />
        </columns>
    </TableView>

    <Label layoutX="50" layoutY="460" text="Quantity:" />
    <TextField fx:id="quantityField" layoutX="120" layoutY="455" prefWidth="60" promptText="1" />

    <Button fx:id="addToCartButton" layoutX="200" layoutY="455" onAction="#handleAddToCart" prefWidth="120" text="Add to Cart" />


    <!-- ============ CART (PART OF EVENT 3,6,7,8) ============ -->
    <Label layoutX="450" layoutY="245" text="Cart Items:" />

    <TableView fx:id="cartTable" layoutX="450" layoutY="270" prefHeight="180" prefWidth="390">
        <columns>
            <TableColumn fx:id="cartProductColumn" prefWidth="180" text="Product" />
            <TableColumn fx:id="cartPriceColumn" prefWidth="90" text="Price" />
            <TableColumn fx:id="cartQtyColumn" prefWidth="60" text="Qty" />
        </columns>
    </TableView>


    <!-- ============ SHIPPING & PAYMENT (EVENT 4 & 5) ============ -->
    <Label layoutX="50" layoutY="500" text="Shipping Address:" />
    <TextArea fx:id="shippingAddressField" layoutX="180" layoutY="495" prefHeight="60" prefWidth="230" promptText="Enter full address" />

    <Label layoutX="50" layoutY="565" text="Phone:" />
    <TextField fx:id="phoneField" layoutX="180" layoutY="560" prefWidth="230" promptText="Phone number" />

    <Label layoutX="450" layoutY="500" text="Card Number:" />
    <TextField fx:id="cardNumberField" layoutX="560" layoutY="495" prefWidth="220" promptText="16-digit card number" />

    <Label layoutX="450" layoutY="535" text="CVV:" />
    <TextField fx:id="cvvField" layoutX="560" layoutY="530" prefWidth="80" promptText="3 digits" />

    <Label layoutX="450" layoutY="570" text="Expiry:" />
    <TextField fx:id="expiryField" layoutX="560" layoutY="565" prefWidth="100" promptText="MM/YY" />

    <!-- Validation message (EVENT 5) -->
    <Label fx:id="validationMessageLabel" layoutX="50" layoutY="600" textFill="red" />


    <!-- ============ CALCULATION & SUMMARY (EVENT 7 & 8) ============ -->
    <Button fx:id="calculateButton" layoutX="450" layoutY="610" onAction="#handleCalculateOrder" prefWidth="150" text="Calculate Order" />

    <Label layoutX="620" layoutY="615" text="Total:" />
    <Label fx:id="totalCostLabel" layoutX="670" layoutY="615" text="0.00" />

    <Label layoutX="620" layoutY="640" text="Tax:" />
    <Label fx:id="taxAmountLabel" layoutX="670" layoutY="640" text="0.00" />

    <Label layoutX="620" layoutY="665" text="Discount:" />
    <Label fx:id="discountLabel" layoutX="690" layoutY="665" text="0.00" />

    <Label layoutX="620" layoutY="690" text="Final:" />
    <Label fx:id="finalAmountLabel" layoutX="670" layoutY="690" text="0.00" />

    <TextArea fx:id="orderSummaryArea" editable="false" layoutX="50" layoutY="630" prefHeight="90" prefWidth="360" promptText="Order summary and confirmation details will appear here..." />


    <!-- ============ CONFIRM ORDER (EVENT 9 & 10) ============ -->
    <Button fx:id="confirmOrderButton" layoutX="50" layoutY="730" onAction="#handleConfirmOrder" prefWidth="180" text="Confirm Order" />

    <!-- Order placed successfully + receipt number -->
    <Label fx:id="orderStatusLabel" layoutX="250" layoutY="735" textFill="green" />

    <Label layoutX="450" layoutY="735" text="Receipt No:" />
    <Label fx:id="receiptNumberLabel" layoutX="530" layoutY="735" text="" />
</AnchorPane>
