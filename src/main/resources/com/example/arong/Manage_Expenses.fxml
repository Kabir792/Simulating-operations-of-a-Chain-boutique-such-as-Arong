<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="600" prefWidth="800" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.arong.ManageExpensesController">

    <Label fx:id="loginMessageLabel" layoutX="150" layoutY="170" textFill="red" />


    <!-- ================= DASHBOARD (EVENT 2) ================= -->
    <Label layoutX="50" layoutY="220" style="-fx-font-size: 18px; -fx-font-weight: bold;" text="Dashboard" />

    <Button fx:id="manageExpensesButton" layoutX="50" layoutY="260" onAction="#handleOpenManageExpenses" prefWidth="180" text="Manage Expenses" />


    <!-- ======== MANAGE BRANCH EXPENSES (EVENT 3–6) ======== -->
    <Label layoutX="50" layoutY="320" style="-fx-font-size: 18px; -fx-font-weight: bold;" text="Manage Branch Expenses" />

    <!-- event-3: enter category, amount, date -->
    <Label layoutX="50" layoutY="360" text="Expense Category:" />
    <TextField fx:id="categoryField" layoutX="180" layoutY="355" prefWidth="200" promptText="e.g. Rent, Utilities" />

    <Label layoutX="50" layoutY="395" text="Amount:" />
    <TextField fx:id="amountField" layoutX="180" layoutY="390" prefWidth="200" promptText="e.g. 15000" />

    <Label layoutX="50" layoutY="430" text="Date:" />
    <DatePicker fx:id="datePicker" layoutX="180" layoutY="425" prefWidth="200" />

    <!-- event-4: validation message -->
    <Label fx:id="validationMessageLabel" layoutX="50" layoutY="465" textFill="red" />

    <!-- event-5: save expense (DB in controller), event-6: success message -->
    <Button fx:id="saveExpenseButton" layoutX="50" layoutY="495" onAction="#handleSaveExpense" prefWidth="150" text="Save Expense" />

    <!-- success / status message (event-6) -->
    <Label fx:id="statusLabel" layoutX="220" layoutY="500" textFill="green" />

</AnchorPane>
