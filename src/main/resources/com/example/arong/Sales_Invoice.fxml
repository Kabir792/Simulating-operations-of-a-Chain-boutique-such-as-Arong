<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="650.0" prefWidth="950.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.oop_final_project.SalesInvoiceController">

    <children>

        <Label fx:id="loginMessageLabel" layoutX="150.0" layoutY="170.0" textFill="red" />


        <!-- ============ SALES DASHBOARD (EVENT 2) ============ -->
        <Label layoutX="50.0" layoutY="220.0" style="-fx-font-size: 18px; -fx-font-weight: bold;" text="Sales Dashboard" />

        <Label layoutX="50.0" layoutY="255.0" style="-fx-font-size: 14px; -fx-font-weight: bold;" text="Customer Orders" />

        <!-- ============ ORDERS TABLE (EVENT 3–4) ============ -->
        <TableView fx:id="ordersTable" layoutX="50.0" layoutY="280.0" prefHeight="220.0" prefWidth="380.0">
            <columns>
                <TableColumn fx:id="orderIdColumn" prefWidth="120.0" text="Order ID" />
                <TableColumn fx:id="orderCustomerColumn" prefWidth="160.0" text="Customer" />
                <TableColumn fx:id="orderDateColumn" prefWidth="100.0" text="Date" />
            </columns>
        </TableView>

        <!-- event-3: Select order & click “Generate Invoice.” -->
        <Button fx:id="generateInvoiceButton" layoutX="50.0" layoutY="510.0" onAction="#handleGenerateInvoice" prefWidth="160.0" text="Generate Invoice" />

        <Label fx:id="ordersMessageLabel" layoutX="230.0" layoutY="515.0" textFill="red" />


        <!-- ============ INVOICE AREA (EVENT 5–7) ============ -->
        <Label layoutX="470.0" layoutY="220.0" style="-fx-font-size: 18px; -fx-font-weight: bold;" text="Invoice Preview" />

        <!-- Customer & invoice info -->
        <Label layoutX="470.0" layoutY="255.0" text="Invoice No:" />
        <Label fx:id="invoiceNumberLabel" layoutX="550.0" layoutY="255.0" text="" />

        <Label layoutX="470.0" layoutY="280.0" text="Customer ID:" />
        <Label fx:id="customerIdLabel" layoutX="550.0" layoutY="280.0" text="" />

        <Label layoutX="470.0" layoutY="305.0" text="Customer Name:" />
        <Label fx:id="customerNameLabel" layoutX="580.0" layoutY="305.0" text="" />

        <Label layoutX="470.0" layoutY="330.0" text="Date:" />
        <Label fx:id="invoiceDateLabel" layoutX="520.0" layoutY="330.0" text="" />


        <!-- Invoice items table -->
        <TableView fx:id="invoiceItemsTable" layoutX="470.0" layoutY="360.0" prefHeight="180.0" prefWidth="430.0">
            <columns>
                <TableColumn fx:id="itemProductColumn" prefWidth="200.0" text="Product" />
                <TableColumn fx:id="itemQtyColumn" prefWidth="60.0" text="Qty" />
                <TableColumn fx:id="itemPriceColumn" prefWidth="80.0" text="Price" />
                <TableColumn fx:id="itemTotalColumn" prefWidth="90.0" text="Total" />
            </columns>
        </TableView>

        <!-- Totals -->
        <Label layoutX="470.0" layoutY="550.0" text="Subtotal:" />
        <Label fx:id="subtotalLabel" layoutX="540.0" layoutY="550.0" text="0.00" />

        <Label layoutX="470.0" layoutY="575.0" text="Tax:" />
        <Label fx:id="taxLabel" layoutX="540.0" layoutY="575.0" text="0.00" />

        <Label layoutX="470.0" layoutY="600.0" text="Grand Total:" />
        <Label fx:id="grandTotalLabel" layoutX="560.0" layoutY="600.0" text="0.00" />

        <!-- Optional notes / footer -->
        <TextArea fx:id="invoiceNotesArea" editable="false" layoutX="650.0" layoutY="550.0" prefHeight="60.0" prefWidth="250.0" promptText="Invoice notes..." />

        <!-- event-6: Print / Export PDF -->
        <Button fx:id="printButton" layoutX="470.0" layoutY="630.0" onAction="#handlePrintInvoice" prefWidth="100.0" text="Print" />

        <Button fx:id="exportPdfButton" layoutX="580.0" layoutY="630.0" onAction="#handleExportPdf" prefWidth="120.0" text="Export PDF" />

        <!-- event-7: success message -->
        <Label fx:id="statusLabel" layoutX="720.0" layoutY="635.0" textFill="green" />

    </children>
</AnchorPane>
