<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="600" prefWidth="900" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.arong.CustomerTrackOrderController">

    <Label fx:id="loginMessageLabel" layoutX="150" layoutY="170" textFill="red" />


    <!-- ============ CUSTOMER DASHBOARD (EVENT 2) ============ -->
    <Label layoutX="50" layoutY="210" style="-fx-font-size: 18px; -fx-font-weight: bold;" text="Customer Dashboard" />

    <Button fx:id="trackOrderMenuButton" layoutX="50" layoutY="245" onAction="#handleOpenTrackOrder" prefWidth="150" text="Track Order" />


    <!-- ============ TRACK ORDER AREA (EVENT 3–6) ============ -->
    <Label layoutX="50" layoutY="285" style="-fx-font-size: 18px; -fx-font-weight: bold;" text="Track Your Order" />

    <!-- event-3: enter order ID OR choose from list -->
    <Label layoutX="50" layoutY="320" text="Enter Order ID:" />
    <TextField fx:id="orderIdField" layoutX="160" layoutY="315" prefWidth="180" promptText="e.g. ORD12345" />

    <Button fx:id="searchOrderButton" layoutX="360" layoutY="315" onAction="#handleSearchOrder" prefWidth="80" text="Search" />

    <Label layoutX="50" layoutY="350" text="Or select from your recent orders:" />

    <TableView fx:id="ordersTable" layoutX="50" layoutY="375" prefHeight="150" prefWidth="400">
        <columns>
            <TableColumn fx:id="orderIdColumn" prefWidth="120" text="Order ID" />
            <TableColumn fx:id="orderDateColumn" prefWidth="120" text="Order Date" />
            <TableColumn fx:id="orderTotalColumn" prefWidth="120" text="Total" />
        </columns>
    </TableView>

    <!-- event-4 & event-5: system verifies ID and fetches order & status (in controller) -->

    <!-- ============ ORDER DETAILS & STATUS (EVENT 6) ============ -->
    <Label layoutX="500" layoutY="350" style="-fx-font-size: 16px; -fx-font-weight: bold;" text="Order Details" />

    <Label layoutX="500" layoutY="380" text="Order ID:" />
    <Label fx:id="detailOrderIdLabel" layoutX="600" layoutY="380" text="" />

    <Label layoutX="500" layoutY="410" text="Status:" />
    <Label fx:id="statusLabel" layoutX="600" layoutY="410" text="" />

    <Label layoutX="500" layoutY="440" text="Estimated Delivery:" />
    <Label fx:id="estimatedDeliveryLabel" layoutX="650" layoutY="440" text="" />

    <Label layoutX="500" layoutY="470" text="Items:" />
    <TextArea fx:id="itemsTextArea" editable="false" layoutX="500" layoutY="490" prefHeight="80" prefWidth="350" promptText="Ordered items will appear here..." />

    <!-- general message area for errors / info -->
    <Label fx:id="messageLabel" layoutX="50" layoutY="540" textFill="red" />

</AnchorPane>
