<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="650.0" prefWidth="950.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.oop_final_project.SalesCancelOrderController">

    <children>

        <Label fx:id="loginMessageLabel" layoutX="150.0" layoutY="170.0" textFill="red" />


        <!-- ============ SALES DASHBOARD (EVENT 2 & 3) ============ -->
        <Label layoutX="50.0" layoutY="220.0" style="-fx-font-size: 18px; -fx-font-weight: bold;" text="Sales Dashboard" />

        <!-- event-3: Click “Cancel Order.” -->
        <Button fx:id="openCancelOrderButton" layoutX="50.0" layoutY="255.0" onAction="#handleOpenCancelOrder" prefWidth="180.0" text="Cancel Order" />


        <!-- ============ PENDING ORDERS (EVENT 4–5) ============ -->
        <Label layoutX="50.0" layoutY="295.0" style="-fx-font-size: 14px; -fx-font-weight: bold;" text="Pending Orders (Before Packaging)" />

        <TableView fx:id="pendingOrdersTable" layoutX="50.0" layoutY="320.0" prefHeight="220.0" prefWidth="500.0">
            <columns>
                <TableColumn fx:id="orderIdColumn" prefWidth="100.0" text="Order ID" />
                <TableColumn fx:id="customerColumn" prefWidth="150.0" text="Customer" />
                <TableColumn fx:id="statusColumn" prefWidth="120.0" text="Status" />
                <TableColumn fx:id="dateColumn" prefWidth="120.0" text="Order Date" />
            </columns>
        </TableView>

        <!-- event-4: enter order ID OR use selection -->
        <Label layoutX="50.0" layoutY="555.0" text="Order ID to Cancel:" />
        <TextField fx:id="orderIdField" layoutX="180.0" layoutY="550.0" prefWidth="150.0" promptText="Enter or select above" />

        <!-- event-5: eligibility / validation message -->
        <Label fx:id="validationMessageLabel" layoutX="50.0" layoutY="580.0" textFill="red" />


        <!-- ============ CANCEL ACTION (EVENT 6–7) ============ -->
        <!-- event-6: update order status to “Cancelled.” -->
        <Button fx:id="cancelOrderButton" layoutX="50.0" layoutY="610.0" onAction="#handleCancelOrder" prefWidth="200.0" text="Confirm Cancel Order" />

        <!-- event-7: display success message -->
        <Label fx:id="statusLabel" layoutX="270.0" layoutY="615.0" textFill="green" />

    </children>
</AnchorPane>
