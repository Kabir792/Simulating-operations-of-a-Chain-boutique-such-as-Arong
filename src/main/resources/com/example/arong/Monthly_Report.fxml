<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="600" prefWidth="800" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.arong.MonthlyReportController">

    <Label fx:id="loginMessageLabel" layoutX="150" layoutY="170" textFill="red" />


    <!-- ================= DASHBOARD (EVENT 2) ================= -->
    <Label layoutX="50" layoutY="220" style="-fx-font-size: 18px; -fx-font-weight: bold;" text="Dashboard" />

    <Button fx:id="generateMonthlyReportButton" layoutX="50" layoutY="260" onAction="#handleOpenMonthlyReport" prefWidth="200" text="Generate Monthly Report" />


    <!-- ======== MONTHLY REPORT AREA (EVENT 3–8) ======== -->
    <Label layoutX="50" layoutY="320" style="-fx-font-size: 18px; -fx-font-weight: bold;" text="Monthly Financial Report" />

    <!-- event-3: enter month & year -->
    <Label layoutX="50" layoutY="360" text="Month:" />
    <TextField fx:id="monthField" layoutX="150" layoutY="355" prefWidth="150" promptText="e.g. 01 or January" />

    <Label layoutX="50" layoutY="395" text="Year:" />
    <TextField fx:id="yearField" layoutX="150" layoutY="390" prefWidth="150" promptText="e.g. 2025" />

    <!-- event-4: validation message -->
    <Label fx:id="validationMessageLabel" layoutX="50" layoutY="425" textFill="red" />

    <!-- event-5: fetch & compute, event-6: show summary -->
    <Button fx:id="generateReportButton" layoutX="50" layoutY="455" onAction="#handleGenerateReport" prefWidth="150" text="Generate Report" />

    <!-- ======= SUMMARY (moved to the right so it doesn't overlap) ======= -->
    <Label layoutX="380" layoutY="360" text="Total Income:" />
    <Label fx:id="incomeLabel" layoutX="500" layoutY="360" text="0.0" />

    <Label layoutX="380" layoutY="390" text="Total Expenses:" />
    <Label fx:id="expensesLabel" layoutX="500" layoutY="390" text="0.0" />

    <Label layoutX="380" layoutY="420" text="Profit:" />
    <Label fx:id="profitLabel" layoutX="500" layoutY="420" text="0.0" />

    <!-- Optional detailed summary text -->
    <TextArea fx:id="summaryTextArea" editable="false" layoutX="380" layoutY="450" prefHeight="100" prefWidth="380" promptText="Financial report summary will appear here..." />

    <!-- event-7: export as PDF -->
    <Button fx:id="exportPdfButton" layoutX="50" layoutY="500" onAction="#handleExportPdf" prefWidth="150" text="Export as PDF" />

    <!-- event-8: export confirmation / status -->
    <Label fx:id="statusLabel" layoutX="50" layoutY="540" textFill="green" />

</AnchorPane>
