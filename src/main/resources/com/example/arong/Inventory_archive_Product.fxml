<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="600.0" prefWidth="900.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.oop_final_project.InventoryArchiveController">

    <children>

        <Label fx:id="loginMessageLabel" layoutX="150.0" layoutY="170.0" textFill="red" />


        <!-- ============ INVENTORY DASHBOARD (EVENT 2) ============ -->
        <Label layoutX="50.0" layoutY="220.0" style="-fx-font-size: 18px; -fx-font-weight: bold;" text="Inventory Dashboard" />

        <Label layoutX="50.0" layoutY="255.0" style="-fx-font-size: 14px; -fx-font-weight: bold;" text="Discontinued Products" />

        <!-- ============ PRODUCT TABLE (DISCONTINUED LIST) ============ -->
        <TableView fx:id="discontinuedTable" layoutX="50.0" layoutY="280.0" prefHeight="220.0" prefWidth="800.0">
            <columns>
                <TableColumn fx:id="productIdColumn" prefWidth="60.0" text="ID" />
                <TableColumn fx:id="productNameColumn" prefWidth="260.0" text="Product Name" />
                <TableColumn fx:id="categoryColumn" prefWidth="160.0" text="Category" />
                <TableColumn fx:id="statusColumn" prefWidth="100.0" text="Status" />
                <TableColumn fx:id="reasonColumn" prefWidth="220.0" text="Discontinuation Reason" />
            </columns>
        </TableView>

        <!-- ============ ARCHIVE AREA (EVENT 3–6) ============ -->

        <!-- event-3: select discontinued product and click “Archive Product.” -->
        <Button fx:id="archiveButton" layoutX="50.0" layoutY="520.0" onAction="#handleArchiveProduct" prefWidth="160.0" text="Archive Product" />

        <!-- Show which product is selected -->
        <Label layoutX="230.0" layoutY="525.0" text="Selected Product:" />
        <Label fx:id="selectedProductLabel" layoutX="340.0" layoutY="525.0" text="None" />

        <!-- event-4: verify product exists and is marked discontinued (message for errors) -->
        <Label fx:id="validationMessageLabel" layoutX="50.0" layoutY="550.0" textFill="red" />

        <!-- event-5 & 6: update to 'Archived' + confirmation -->
        <Label fx:id="statusLabel" layoutX="50.0" layoutY="575.0" textFill="green" />

    </children>
</AnchorPane>
